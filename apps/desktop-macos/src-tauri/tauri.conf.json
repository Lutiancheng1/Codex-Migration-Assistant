{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Migration Assistant",
  "version": "1.1.0",
  "identifier": "com.lutiancheng.codexmigrationassistant",
  "build": {
    "beforeDevCommand": "cd .. && npm run dev",
    "beforeBuildCommand": "cd .. && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex 迁移助手",
        "width": 1440,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../node_modules/sql.js/dist/sql-wasm.wasm": "desktop/sql-wasm.wasm"
    },
    "externalBin": [
      "binaries/codex-desktop-runner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
