{
  "name": "@codex-migration/desktop-macos",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "tauri:dev": "npm run build:sidecar && tauri dev",
    "tauri:build": "npm run build:sidecar && tauri build",
    "release:unsigned": "npm run tauri:build || true && node scripts/build-release-artifacts.mjs",
    "generate:icons": "tauri icon assets/app-icon.svg -o src-tauri/icons"
  },
  "dependencies": {
    "@codex-migration/shared-contracts": "*",
    "@codex-migration/shared-ui": "*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.15.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.21"
  }
}
