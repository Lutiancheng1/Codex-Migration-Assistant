{
  "name": "codex-migration-assistant",
  "displayName": "Codex 迁移助手",
  "description": "面向 Codex 的账号切换、数据迁移、备份恢复与会话清理扩展。",
  "version": "0.1.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lutiancheng1/Codex-Migration-Assistant.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "codex",
    "migration",
    "backup",
    "import",
    "export",
    "profile-switch",
    "session-cleanup"
  ],
  "activationEvents": [
    "onView:codexMigration.sidebarView",
    "onCommand:codexMigration.open",
    "onCommand:codexMigration.export",
    "onCommand:codexMigration.previewImport",
    "onCommand:codexMigration.import"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexMigration.open",
        "title": "Codex 迁移助手：打开面板"
      },
      {
        "command": "codexMigration.export",
        "title": "Codex 迁移助手：导出"
      },
      {
        "command": "codexMigration.previewImport",
        "title": "Codex 迁移助手：预演导入"
      },
      {
        "command": "codexMigration.import",
        "title": "Codex 迁移助手：执行导入"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexMigration",
          "title": "Codex迁移",
          "icon": "media/codex-migration.svg"
        }
      ]
    },
    "views": {
      "codexMigration": [
        {
          "id": "codexMigration.sidebarView",
          "name": "迁移助手",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist dist-webview",
    "build:ext": "tsc -p tsconfig.json",
    "build:webview": "vite build --config webview/vite.config.ts",
    "build": "npm run build:webview && npm run build:ext",
    "package:vsix": "npm run build && npx @vscode/vsce package",
    "package:vsix:node20": "bash -lc 'eval \"$(fnm env)\" && fnm use 20 >/dev/null && npm run build && npx @vscode/vsce package'",
    "watch:ext": "tsc -w -p tsconfig.json",
    "watch:webview": "vite build --watch --config webview/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test:unit": "npm run build:ext && node --test test"
  },
  "dependencies": {
    "@types/sql.js": "^1.4.9",
    "sql.js": "^1.13.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/vscode": "^1.90.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  },
  "icon": "media/codex-migration.png"
}
